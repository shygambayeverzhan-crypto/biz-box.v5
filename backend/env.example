# Copy this file to .env and fill in real values. Never commit .env.

# Your Anthropic API key (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# The code YOU type to unlock the admin panel. Change this to something
# only you know. This check happens on the server, so it is safe here
# unlike putting it in the frontend HTML.
ADMIN_CODE=Yerzhan_2005_change_me

# Port the server listens on (most hosts set this automatically)
PORT=3000
